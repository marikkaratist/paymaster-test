LOG_LEVEL=INFO
POSTGRES_DSN=postgresql+psycopg://paymaster-test:paymaster-test@postgres:5432/paymaster-test
POSTGRES_USER=paymaster-test
POSTGRES_PASSWORD=paymaster-test
POSTGRES_DB=paymaster-test
RABBITMQ_DSN=amqp://guest:guest@rabbitmq:5672/
API_KEY=secret-api-key

EXCHANGE_NAME=payments
QUEUE_NAME=payments.new
DLQ_NAME=payments.dlq
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=2000

GATEWAY_MIN_DELAY=2.0
GATEWAY_MAX_DELAY=5.0
GATEWAY_SUCCESS_RATE=0.9

WEBHOOK_TIMEOUT=5.0

RELAY_BATCH_SIZE=100
RELAY_POLL_INTERVAL=1.0
